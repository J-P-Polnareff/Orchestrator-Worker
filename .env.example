# Copy to .env and fill in real values. .env is git-ignored.

# Which adapter the registry should build: deepseek
LLM_PROVIDER=deepseek

# DeepSeek credentials (OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Shared generation defaults
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2